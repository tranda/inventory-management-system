# IT Inventory Management System - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=inventory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=inventory
DATABASE_URL=postgresql://inventory:your_secure_password_here@localhost:5432/inventory?schema=public

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# JWT Authentication (Constitution Art. 5.1)
# Generate secure secrets: openssl rand -base64 64
# =============================================================================
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
# Access token expires in 15 minutes (Constitution Art. 5.1)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token expires in 7 days (Constitution Art. 5.1)
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# =============================================================================
# File Upload (Constitution constraints: 5MB max)
# =============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# =============================================================================
# Email (SMTP) - for notifications
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=inventory@yourcompany.com

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=your_session_secret_here
COOKIE_DOMAIN=localhost
